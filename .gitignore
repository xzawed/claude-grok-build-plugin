node_modules/
# Build output is ignored EXCEPT the committed self-contained server bundle
# (dist/index.js), which the plugin ships so end-users need no install/build.
# See mcp-server/build.mjs and .mcp.json.
mcp-server/dist/*
!mcp-server/dist/index.js
!mcp-server/dist/hook.js
.superpowers/
# Per-clone SCAManager credentials. The pre-push hook reads this locally and
# exits 0 when it is absent (.scamanager/install-hook.sh), so untracking it
# costs nothing — and this repo is public, where a committed token is exposed.
.scamanager/config.json
