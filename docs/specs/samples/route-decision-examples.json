{
  "_comment": "Example RouteDecision + nextAction from routeTask/planNextAction / grok_build_route for orchestrator tests.",
  "examples": [
    {
      "name": "bulk_low_risk",
      "input": {
        "signals": { "bulk": true, "lowRiskDomain": true }
      },
      "expected": {
        "risk": "LOW",
        "worker": "grok",
        "suggestedTool": "grok_build_verify",
        "nextAction": {
          "phase": "call_mcp_tool",
          "tool": "grok_build_verify"
        }
      }
    },
    {
      "name": "security_beats_bulk",
      "input": {
        "signals": { "bulk": true, "security": true }
      },
      "expected": {
        "risk": "HIGH",
        "worker": "claude",
        "nextAction": {
          "phase": "handle_with_claude"
        }
      }
    },
    {
      "name": "vague_task",
      "input": {
        "task": "improve things"
      },
      "expected": {
        "risk": "MEDIUM",
        "worker": "plan_then_grok",
        "suggestedTool": "grok_build_plan",
        "nextAction": {
          "phase": "call_mcp_tool",
          "tool": "grok_build_plan",
          "requiresHumanGateBeforeDelegate": true
        }
      }
    },
    {
      "name": "metered_strict",
      "input": {
        "signals": { "exploratory": true },
        "meteredBilling": true
      },
      "expected": {
        "risk": "MEDIUM",
        "worker": "plan_then_grok",
        "nextAction": {
          "phase": "call_mcp_tool",
          "tool": "grok_build_plan",
          "requiresHumanGateBeforeDelegate": true
        }
      }
    },
    {
      "name": "bulk_delegate",
      "input": {
        "signals": { "bulk": true }
      },
      "expected": {
        "risk": "LOW",
        "worker": "grok",
        "suggestedTool": "grok_build_delegate",
        "nextAction": {
          "phase": "call_mcp_tool",
          "tool": "grok_build_delegate"
        }
      }
    }
  ]
}
